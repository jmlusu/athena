# Dockerfile.frontend — Express BFF + React SPA (dev & prod)
# Build stage
FROM node:24-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Dev stage (Vite + Express with hot reload)
FROM node:24-alpine AS dev
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
EXPOSE 3000
CMD ["npm", "run", "dev"]

# Production stage (Express serves static dist)
FROM node:24-alpine AS prod
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY package*.json ./
COPY server.ts ./
EXPOSE 3000
ENV NODE_ENV=production
CMD ["npm", "start"]