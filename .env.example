# Athena Environment Variables
# Copy to .env and customize

# Backend
ATHENA_API_KEY=dev-admin-key
ATHENA_CORS_ORIGINS=http://localhost:8530,http://127.0.0.1:8530
ATHENA_AUTH_MODE=api_key
ATHENA_RATE_LIMIT=100
ATHENA_DATA_DIR=./company/athena

# Dual-environment (OpenCode local vs AI Studio preview)
# AI Studio sets AISTUDIO_PREVIEW=true; it relaxes CSP frame-ancestors for preview framing
# and defaults the bind host to 0.0.0.0. OpenCode local defaults to 127.0.0.1 with a strict CSP.
AISTUDIO_PREVIEW=false
HOST=127.0.0.1
PORT=8000

# Scheduler (auto-started on boot; disable with ATHENA_SCHEDULER_AUTOSTART=false)
ATHENA_SCHEDULER_AUTOSTART=true
ATHENA_DEFAULT_SCRAPE_QUERY=software engineer
ATHENA_DEFAULT_SCRAPE_LOCATION=
ATHENA_DEFAULT_SCRAPE_MAX=50

# Optional: External HITL gate (requires ai_company installed)
# ATHENA_HITL_EXTERNAL=true

# Optional: External LLM for document humanization
# ATHENA_LLM_PROVIDER=openai

# Frontend
VITE_ATHENA_API_BASE=/api/v1/athena
# Must match ATHENA_API_KEY (baked into the client bundle at build time)
VITE_ATHENA_API_KEY=dev-admin-key