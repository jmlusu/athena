AISTUDIO_PREVIEW=
ATHENA_API_KEY=
ATHENA_AUTH_MODE=
ATHENA_CORS_ORIGINS=
ATHENA_DATA_DIR=
ATHENA_DEFAULT_SCRAPE_LOCATION=
ATHENA_DEFAULT_SCRAPE_MAX=50
ATHENA_DEFAULT_SCRAPE_QUERY=
ATHENA_RATE_LIMIT=
ATHENA_SCHEDULER_AUTOSTART=

# Optional: External HITL gate (requires ai_company installed)
# ATHENA_HITL_EXTERNAL=true

# Optional: External LLM for document humanization (legacy, replaced by ATHENA_AI_PROVIDER)
# ATHENA_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# AI Provider (gemini | omniroute | local | fallback)
ATHENA_AI_PROVIDER=fallback
# Gemini API key (server-side only, never exposed to frontend)
GEMINI_API_KEY=
# n8n webhook URL for workflow orchestration
ATHENA_N8N_WEBHOOK_URL=https://n8n.athena-ops.internal/webhook/athena-pipeline-trigger

# Frontend
VITE_ATHENA_API_BASE=/api/v1/athena
# Must match ATHENA_API_KEY (baked into the client bundle at build time)
VITE_ATHENA_API_KEY=dev-admin-key
HOST=