# Athena Environment Variables
# Copy to .env and customize

# Backend
ATHENA_API_KEY=your-secure-api-key-here
ATHENA_CORS_ORIGINS=http://localhost:8530,http://127.0.0.1:8530
ATHENA_AUTH_MODE=api_key
ATHENA_RATE_LIMIT=100
ATHENA_DATA_DIR=./company/athena

# Optional: External HITL gate (requires ai_company installed)
# ATHENA_HITL_EXTERNAL=true

# Optional: External LLM for document humanization
# ATHENA_LLM_PROVIDER=openai

# Frontend
VITE_ATHENA_API_BASE=/api/v1/athena