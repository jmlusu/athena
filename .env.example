# Gemini API key (server-side only; read by FastAPI backend)
GEMINI_API_KEY=

# FastAPI backend configuration
# Empty = dev fallback: key `dev-admin-key`, accepted from loopback clients only.
# Non-loopback ATHENA_HOST with empty/CHANGE_ME key refuses to start (fail-closed).
ATHENA_API_KEY=
ATHENA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# api_key (default, production posture: API-key auth always enforced,
# interactive docs /docs /redoc /openapi.json disabled) | open
# (localhost-only dev: loopback binds, docs served). Never disables
# API-key enforcement.
ATHENA_AUTH_MODE=api_key
# Provider switch: gemini (needs GEMINI_API_KEY) | fallback (rule-based, no key).
# Code default when unset is `fallback`.
ATHENA_AI_PROVIDER=gemini
ATHENA_RATE_LIMIT=100
# Intended bind host. Read only by the AUTH_MODE=open loopback guard in
# app.py — the actual uvicorn --host/--port come from the launch command.
# ATHENA_HOST=127.0.0.1
# Data directory for JSONL stores. Leave unset to use the repo default
# (<repo>/company/athena, independent of the working directory). If you set it,
# use an ABSOLUTE path: a relative value resolves against the process working
# directory, so launching from backend/ silently reads a different data dir.
# ATHENA_DATA_DIR=/absolute/path/to/athena-data
ATHENA_SCHEDULER_AUTOSTART=true
ATHENA_DEFAULT_SCRAPE_QUERY=software engineer
ATHENA_DEFAULT_SCRAPE_MAX=50

# Scrape concurrency. Default 1 (strictly sequential) for steady state.
# Bulk backfills can raise this for one run, e.g. ATHENA_MAX_CONCURRENT_SCRAPERS=8,
# which is safe because store writes are atomic and guarded.
ATHENA_MAX_CONCURRENT_SCRAPERS=1
# Per-source wall-clock budget for a single scrape attempt (seconds).
ATHENA_SCRAPE_SOURCE_TIMEOUT=20
# Shorter budget for sources behind auth/anti-bot walls (LinkedIn/Indeed/Glassdoor).
# They stay enabled so a working session is noticed, but fail fast.
ATHENA_SHORT_SOURCE_TIMEOUT=8
# Consecutive failures within one run before a source is skipped for that run.
ATHENA_SOURCE_FAILURE_THRESHOLD=2
# Set true only to intentionally run two servers against one data directory.
ATHENA_ALLOW_MULTIPLE_INSTANCES=false

# Express BFF configuration
# `npm start` serves the built SPA from dist/ ONLY when NODE_ENV is exactly
# "production". Left at development it takes the Vite-middleware branch, so the
# built app answers every /assets/*.js request with index.html and renders
# blank. Keep development here for `npm run dev`; set production wherever you
# run `npm start`.
NODE_ENV=development
DISABLE_HMR=
# BFF bind address. Default 127.0.0.1 (loopback only). Set 0.0.0.0 only when
# LAN access is intended — pair it with a real ATHENA_API_KEY.
# ATHENA_BFF_HOST=127.0.0.1

# FastAPI origin the BFF proxies /api/v1/athena/* to, and how long it waits for
# it before answering 504. Both are read by server.ts; both default to these
# values if omitted, but they belong in the example because deployments behind a
# remote backend routinely change the first one.
ATHENA_BACKEND_URL=http://127.0.0.1:8000
ATHENA_BACKEND_TIMEOUT_MS=180000

# --- Advanced / rarely changed (read by code, defaults shown) ---------------
# GEMINI_MODEL=gemini-3.8-flash   # AI model id
# ATHENA_DEFAULT_SCRAPE_LOCATION=  # default scrape location filter
# ATHENA_AGENT_ID=                 # audit-trail agent id (default: unknown)
# AISTUDIO_PREVIEW=                # preview-mode flag
# ATHENA_HSTS_MAX_AGE=31536000     # HSTS max-age (seconds)
# ATHENA_TEST_MODE=                # backend test-mode flag (tests only)
# Legacy key aliases still honored by app.py — prefer ATHENA_API_KEY:
# ATHENA_ADMIN_KEY= / ATHENA_APPROVE_KEY= / ATHENA_RUN_KEY=