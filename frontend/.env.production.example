# Frontend Production Environment Variables
# Copy to .env.production and fill in your values

# Backend API URL (required for split deployment)
# Example: https://api.athena.yourdomain.com
# For local dev with separate backend: http://localhost:8000
VITE_ATHENA_API_BASE=https://api.athena.yourdomain.com/api/v1/athena

# Athena API Key (required for write operations)
# Generate a secure key and set the same value in backend's ATHENA_API_KEY
VITE_ATHENA_API_KEY=your-secure-api-key-here

# Optional: Override default build-time values
# VITE_APP_NAME=Athena
# VITE_APP_VERSION=0.1.0