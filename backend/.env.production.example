# Backend Production Environment Variables
# Copy to .env.production (or export in your process manager) and fill in values.
#
# Reality check: Athena uses file-based JSONL storage + file locks.
# There is NO PostgreSQL, NO Redis, NO SMTP in this system.
# Canonical variable reference: /.env.example (development values + explanations).

# --- Process ---
# Intended bind host. Read only by the AUTH_MODE=open loopback guard in
# app.py — the actual uvicorn --host/--port come from your launch command.
ATHENA_HOST=0.0.0.0
ATHENA_TEST_MODE=false

# --- Security ---
# Placeholder sentinel — the app refuses to start fail-closed on a
# non-loopback ATHENA_HOST until this is replaced with a real key.
# Generate with: openssl rand -hex 32  (rotate any previously deployed key)
ATHENA_API_KEY=CHANGE_ME
ATHENA_AUTH_MODE=api_key
# Comma-separated exact origins serving the SPA (no trailing slash)
ATHENA_CORS_ORIGINS=https://app.example.com
ATHENA_RATE_LIMIT=100
ATHENA_HSTS_MAX_AGE=31536000
# Optional CSP override; leave unset to use the built-in policy
# ATHENA_CSP=

# --- AI ---
# Server-side only; never exposed to the browser bundle
GEMINI_API_KEY=
# gemini | fallback (rule-based, no key required; code default when unset = fallback)
ATHENA_AI_PROVIDER=gemini
# Optional external LLM for document humanization (requires ai_company package; not bundled)
# ATHENA_LLM_PROVIDER=

# --- Data ---
# MUST be an absolute path in production
ATHENA_DATA_DIR=/var/lib/athena/company/athena

# --- Scheduler ---
ATHENA_SCHEDULER_AUTOSTART=true
ATHENA_DEFAULT_SCRAPE_QUERY=software engineer
ATHENA_DEFAULT_SCRAPE_MAX=50
ATHENA_MAX_CONCURRENT_SCRAPERS=1
ATHENA_SCRAPE_SOURCE_TIMEOUT=20
ATHENA_SHORT_SOURCE_TIMEOUT=8
ATHENA_SOURCE_FAILURE_THRESHOLD=2
# Only true when intentionally running two servers against one data directory
ATHENA_ALLOW_MULTIPLE_INSTANCES=false

# --- Optional integrations ---
# External HITL gate (requires ai_company package; not bundled)
# ATHENA_HITL_EXTERNAL=true
# n8n webhook egress URL
# ATHENA_N8N_WEBHOOK_URL=
