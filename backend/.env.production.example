# Backend Production Environment Variables
# Copy to .env and fill in your values

# Application
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (PostgreSQL with pgvector)
# Example: postgresql://user:password@host:5432/athena
DATABASE_URL=postgresql://user:password@host:5432/athena

# Redis (for caching, rate limiting, Celery if used)
REDIS_URL=redis://localhost:6379/0

# Security
# Generate with: openssl rand -hex 32
ATHENA_API_KEY=your-secure-api-key-here
SECRET_KEY=your-secret-key-here

# CORS - Comma-separated list of allowed origins
# Include your frontend URL(s)
ALLOWED_ORIGINS=https://athena.yourdomain.com,https://app.athena.yourdomain.com

# AI / LLM
GEMINI_API_KEY=your-gemini-api-key-here

# File Storage
# Local: ./data (default)
# S3: s3://bucket-name/prefix
STORAGE_PATH=./data

# Scraping
PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# Email (for notifications, optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@athena.yourdomain.com